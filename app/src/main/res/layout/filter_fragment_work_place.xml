<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/filter_fragment_workplace"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context="ru.practicum.android.diploma.FilterFragmentWorkPlace">

    <!-- Тулбар -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back_24px"
        app:title="@string/choose_work_place_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_16"
        android:paddingTop="@dimen/padding_16"
        app:layout_constraintBottom_toTopOf="@id/btn_choose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- Страна -->
        <FrameLayout
            android:id="@+id/country_container"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="40dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/country_title"
                    style="@style/TextAppearance.Diploma.Regular16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cuntry"
                    android:textColor="?attr/textColorHint" />

                <TextView
                    android:id="@+id/country_value"
                    style="@style/TextAppearance.Diploma.Regular16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="Россия"
                    tools:visibility="visible" />
            </LinearLayout>

            <ImageView
                android:id="@+id/country_arrow"
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/cuntry"
                android:src="@drawable/ic_arrow_forward_24px"
                app:tint="?attr/textColorPrimary" />
        </FrameLayout>

        <!-- Регион -->
        <FrameLayout
            android:id="@+id/region_container"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="@dimen/padding_8"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="40dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/region_title"
                    style="@style/TextAppearance.Diploma.Regular16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/region"
                    android:textColor="?attr/textColorHint" />

                <TextView
                    android:id="@+id/region_value"
                    style="@style/TextAppearance.Diploma.Regular16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="Москва"
                    tools:visibility="visible" />
            </LinearLayout>

            <ImageView
                android:id="@+id/region_arrow"
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/region"
                android:src="@drawable/ic_arrow_forward_24px"
                app:tint="?attr/textColorPrimary" />
        </FrameLayout>

    </LinearLayout>

    <!-- Кнопка Выбрать -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_choose"
        style="@style/Widget.Diploma.Button"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginHorizontal="@dimen/padding_16"
        android:layout_marginBottom="@dimen/padding_24"
        android:text="@string/btn_title_choose"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
