<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_fragment"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".search.ui.SearchFragment">

    <!-- Заголовок экрана -->
    <LinearLayout
        android:id="@+id/search_fragment_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <Button
        android:id="@+id/button_to_vacancy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Переход к вакансии"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_fragment"
       />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_input_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Переход к фильтру"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_input_layout" />

    <!-- Контейнер результатов и плейсхолдеров -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_input_layout">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="144dp"
            android:indeterminateTint="@color/blue"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trackRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emptyPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|top"
            android:orientation="vertical"
            android:visibility="visible"
            android:background="?attr/colorBackground">

            <ImageView
                android:layout_width="360dp"
                android:layout_height="535dp"
                android:contentDescription="@null"
                android:src="@drawable/img_activity_root" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|top"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@string/network_error"
                android:src="@drawable/ic_no_internet" />

            <TextView
                android:id="@+id/errorMessage"
                style="@style/TextAppearance.Diploma.Medium22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_error" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nothingFinded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|top"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@string/empty_list_vacancies"
                android:src="@drawable/ic_placeholder_nothing_find_vacancy" />

            <TextView
                android:id="@+id/tv_nothingFinded"
                style="@style/TextAppearance.Diploma.Medium22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_list_vacancies" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_clear_vacancies"
                style="@style/Widget.Diploma.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_vacancies"
                app:cornerRadius="@dimen/button_corner_radius" />
        </LinearLayout>
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        app:layout_constraintTop_toBottomOf="@id/button_to_filter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/vacancies_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:layout_margin="16dp"
        tools:listitem="@layout/list_item_vacancy" />
</androidx.constraintlayout.widget.ConstraintLayout>
