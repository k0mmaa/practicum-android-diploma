<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_fragment"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    tools:context=".search.ui.SearchFragment">

    <TextView
        android:id="@+id/text_fragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Фрагмент поиска"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/button_to_vacancy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Переход к вакансии"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_fragment"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        android:id="@+id/button_to_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Переход к фильтру"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_to_vacancy"/>

</androidx.constraintlayout.widget.ConstraintLayout>
